rules_version = '2';
// BBI Africa — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Admins are recognised by email (keep in sync with BBI_ADMIN_EMAILS in
    // js/firebase-config.js). An optional admins/{uid} doc also grants admin.
    function adminEmails() {
      return ['info@drtemesgen.com'];
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in adminEmails()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // Admins registry: each admin is a document whose id is the user's UID.
    // Readable by the owner (so the app can check its own admin status) and by admins.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // manage admins from the Firebase console only
    }

    // User profiles (registrations). approved=false until an admin approves.
    match /users/{uid} {
      // A user creates their own profile at registration (defaulting to not
      // approved); an admin may create a profile for anyone.
      allow create: if isAdmin() || (
                       signedIn()
                       && request.auth.uid == uid
                       && request.resource.data.approved == false
                       && request.resource.data.role == 'applicant'
                    );
      // Read your own profile, or any profile if admin.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admins can change anything; a user may edit their own profile but
      // NOT their approval status or role.
      allow update: if isAdmin() || (
                       signedIn() && request.auth.uid == uid
                       && request.resource.data.approved == resource.data.approved
                       && request.resource.data.role == resource.data.role
                    );
      allow delete: if isAdmin();
    }

    // Certification categories — readable by everyone, managed by admins.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Editable site content (e.g. the ECC page) — public read, admin write.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Professional directory — readable by everyone, managed by admins.
    match /directory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offerings (events / courses / activities) — public read, admin write.
    match /offerings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations for events/courses/activities. A signed-in user creates
    // their own; reads their own; admins read/manage all.
    match /registrations/{id} {
      // A signed-in user submits their own sign-up, which MUST start as 'pending'
      // (an admin approves it to 'registered'). They cannot self-approve.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Applications.
    match /applications/{id} {
      // An APPROVED applicant (or an admin) may create their own application.
      allow create: if (isApproved() || isAdmin())
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'submitted';

      // Read: the owner, or any admin.
      allow read: if signedIn()
                  && (resource.data.uid == request.auth.uid || isAdmin());

      // Update: only admins (e.g. status changes).
      allow update: if isAdmin()
                    && request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin();
    }
  }
}
